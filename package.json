{
  "name": "lexcanvas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prestart": "npm run build",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json && node scripts/build.mjs && node scripts/inject-app-api.mjs",
    "inject:app": "node scripts/inject-app-api.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx evals/run.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "docx": "^9.13.0",
    "hono": "^4.13.13",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-gfm-table": "^2.0.0",
    "micromark-extension-gfm-table": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "jszip": "^3.10.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
