{
  "name": "lexcanvas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prestart": "npm run build",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json && node scripts/build.mjs && node scripts/inject-app-api.mjs",
    "inject:app": "node scripts/inject-app-api.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx evals/run.ts",
    "calibrage": "tsx scripts/calibrage-securite.ts",
    "verif-prod": "tsx scripts/verif-prod.ts",
    "verif-firebase": "tsx scripts/verif-firebase.ts",
    "verif-auth": "tsx scripts/verif-auth.ts",
    "verif-history": "tsx scripts/verif-history.ts",
    "setup-ttl": "tsx scripts/setup-firestore-ttl.ts",
    "purge-history": "tsx scripts/purge-history.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "docx": "^9.13.0",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.3.1",
    "hono": "^4.13.13",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-gfm-table": "^2.0.0",
    "micromark-extension-gfm-table": "^2.1.0",
    "pdfmake": "^0.2.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pdfmake": "^0.3.3",
    "jszip": "^3.10.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
