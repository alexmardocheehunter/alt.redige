# ─────────────────────────────────────────────────────────────────────────────
# LexCanvas — variables d'environnement
# Copiez ce fichier en « .env » et renseignez les valeurs.
# Le serveur refuse de démarrer si une variable obligatoire manque ou est
# invalide : le message indique laquelle.
# ─────────────────────────────────────────────────────────────────────────────

# ── Environnement ────────────────────────────────────────────────────────────
# development | production | test
# En production : l'en-tête HSTS est envoyé. ACCESS_CODE n'est obligatoire
# qu'avec AUTH_MODE=code (en firebase, le jeton Google le remplace).
NODE_ENV=development

# ── Fournisseur de modèle : OpenRouter (obligatoire) ─────────────────────────
# La clé reste sur le serveur : elle n'est jamais transmise au navigateur.
OPENROUTER_API_KEY=

# URL de l'API OpenRouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# En-têtes d'attribution recommandés par OpenRouter (nom et URL du site)
OPENROUTER_APP_TITLE=LexCanvas
OPENROUTER_SITE_URL=

# ── Modèles de rédaction, en ordre de bascule ────────────────────────────────
# Politique produit : **modèles gratuits uniquement** (aucun crédit payant).
# Les cinq entrées Acceptent les appels d'outils et couvrent un large contexte.
# OpenRouter peut les retirer ou les limiter sans préavis (429) : la bascule et
# `npm run verif-prod` protègent la disponibilité. Pour remplacer un modèle,
# vérifier qu'il est encore listé avec `:free` et qu'il accepte `tools`.
LLM_MODELS=dots-studio/dots-3-note-preview:free,nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3.5-super-vl:free,google/gemma-4-31b-it:free

# Alias historique : force le modèle principal en tête de la bascule
# LLM_MODEL=dots-studio/dots-3-note-preview:free

# ── Gardien de sécurité : hors bascule, appelé séparément ────────────────────
LLM_SAFETY_MODEL=nvidia/nemotron-3.5-content-safety:free

# Mettre à 0 pour ne plus consulter le gardien (déconseillé)
SAFETY_CHECK=1

# off      : le gardien n'est jamais consulté
# advisory : (défaut, recommandé) un contenu **hors du domaine juridique**
#            jugé dangereux est bloqué ; un contenu du domaine est journalisé
# block    : bloque tout contenu jugé dangereux — DÉCONSEILLÉ : mesuré, il
#            bloque aussi une demande légitime sur 20
#            (voir docs/CALIBRAGE-SECURITE.md)
SAFETY_MODE=advisory

# ── Serveur ──────────────────────────────────────────────────────────────────
PORT=3000

# Si défini, les routes /api/* (sauf /api/health) exigent l'en-tête
# X-Access-Code. En production, ACCESS_CODE est obligatoire avec AUTH_MODE=code ;
# il ne l'est plus avec AUTH_MODE=firebase (jeton Google obligatoire).
# Choisissez une valeur longue et aléatoire (32 caractères ou plus).
ACCESS_CODE=

# ── Authentification ─────────────────────────────────────────────────────────
# code     : code partagé X-Access-Code (mode historique, sans historique).
# firebase : jeton d'identité Firebase obligatoire (Authorization: Bearer).
# hybrid   : jeton Firebase ou code partagé, pour la transition du frontend.
# Le frontend livré utilise Google ; la production doit rester en firebase.
AUTH_MODE=firebase

# Projet Firebase (obligatoire pour firebase/hybrid et pour les historiques)
FIREBASE_PROJECT_ID=

# Chemin absolu du fichier JSON du compte de service. Si vide, le SDK utilise
# les identifiants par défaut (Application Default Credentials).
FIREBASE_SERVICE_ACCOUNT=

# Clé web publique du projet (Console → Paramètres → Vos applications).
# Elle est publique : elle est aussi intégrée à public/index.html pour le SDK
# Firebase JS. Utilisée par npm run verif-auth et npm run verif-history.
# FIREBASE_WEB_API_KEY=

# ── Historiques de contrats (Firestore) ──────────────────────────────────────
# Réservés aux utilisateurs authentifiés par Firebase (uid). Nécessite
# AUTH_MODE=firebase ou hybrid. Les règles Firestore interdisent l'accès client.
HISTORY_ENABLED=1

# Durée de conservation ; `expires_at` est purgé par la politique TTL si l'offre
# Blaze est active, sinon par `npm run purge-history` (à planifier).
HISTORY_RETENTION_DAYS=90

# Nombre maximal d'historiques par utilisateur (les plus anciens sont purgés).
HISTORY_MAX_PER_USER=100

# Requêtes d'historique par minute et par identité
RATE_HISTORY_PER_MIN=60

# Mettre à 1 derrière un proxy inverse (l'IP client est lue dans
# X-Forwarded-For). À 0 si le serveur est exposé directement.
TRUST_PROXY=0

# Origine(s) autorisée(s) pour un front servi depuis un autre domaine
# (sinon : même origine uniquement). Liste séparée par des virgules.
ALLOWED_ORIGIN=

# URL absolue du backend quand la page est servie par Firebase Hosting.
# Le front appelle Cloud Run directement pour préserver le flux SSE.
# Vide en développement local : les appels restent en même origine.
PUBLIC_API_BASE=

# ── Boucle agentique ─────────────────────────────────────────────────────────
# Nombre maximal d'étapes (appels au modèle) par message
MAX_STEPS=6

# Budget de jetons en sortie. Les modèles de la chaîne raisonnent : le
# raisonnement et la réponse doivent tenir dans le même budget.
MAX_OUTPUT_TOKENS=16000

# Durée maximale d'un flux SSE, en millisecondes (240 s : une génération
# complète de contrat dépasse 120 s)
REQUEST_TIMEOUT_MS=240000

# Nombre maximal de blocs qu'une modification ciblée peut toucher ; au-delà,
# la modification est refusée (le modèle réécrit le document au lieu de
# modifier une clause)
MAX_EDIT_CHANGED_BLOCKS=4

# Nombre maximal de messages d'historique renvoyés au modèle
MAX_HISTORY_MESSAGES=12

# ── Limites de débit ─────────────────────────────────────────────────────────
# Par identité (ou par IP tant que l'authentification individuelle n'est pas
# branchée) : 30 messages par heure, 10 exports par minute.
RATE_CHAT_PER_HOUR=30
RATE_EXPORT_PER_MIN=10

# Corps de requête maximum, en octets (1 Mo)
MAX_BODY_BYTES=1048576

# ── Journalisation et export ──────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info

# Texte ajouté au pied de page des exports Word
EXPORT_FOOTER=Document généré avec assistance IA — à valider par un professionnel du droit avant signature.
