# Clé OpenRouter (obligatoire) — c'est elle qui est appelée par le backend
OPENROUTER_API_KEY=

# URL de l'API OpenRouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# En-têtes d'attribution recommandés par OpenRouter (nom et URL du site)
OPENROUTER_APP_TITLE=LexCanvas
OPENROUTER_SITE_URL=

# Modèles de rédaction, en ordre de bascule (le premier qui répond l'emporte)
LLM_MODELS=minimax/minimax-m3.1-flash:free,nvidia/nemotron-3.5-super-vl:free

# Alias historique : force le modèle principal en tête de la bascule
# LLM_MODEL=minimax/minimax-m3.1-flash:free

# Gardien de sécurité : hors bascule, appelé séparément sur les entrées et les sorties
LLM_SAFETY_MODEL=nvidia/nemotron-3.5-content-safety:free
# Mettre à 0 pour désactiver le filtre (déconseillé)
SAFETY_CHECK=1

# Port d'écoute du serveur
PORT=3000

# Si défini, toutes les routes /api/* (sauf /api/health) exigent l'en-tête X-Access-Code
ACCESS_CODE=

# Bornes de la boucle agentique
MAX_STEPS=6
MAX_OUTPUT_TOKENS=16000

# Durée maximale d'un flux SSE, en millisecondes (240 s : les modèles de la
# chaîne sont à raisonnement, une génération complète dépasse 120 s)
REQUEST_TIMEOUT_MS=240000

# Limites de débit par IP
RATE_CHAT_PER_HOUR=30
RATE_EXPORT_PER_MIN=10

# Corps de requête maximum, en octets
MAX_BODY_BYTES=1048576

# Niveau de journalisation : debug | info | warn | error
LOG_LEVEL=info

# Mettre à 1 pour lire l'IP client dans X-Forwarded-For (derrière un proxy)
TRUST_PROXY=0

# Origine autorisée pour un front séparé en développement (sinon : même origine)
ALLOWED_ORIGIN=

# Texte ajouté au pied de page des exports Word
EXPORT_FOOTER=Document généré avec assistance IA — à valider par un professionnel du droit avant signature.
