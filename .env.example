# Clé du fournisseur de modèle (obligatoire)
ANTHROPIC_API_KEY=

# Modèle utilisé par l'agent
LLM_MODEL=claude-sonnet-5-5

# Port d'écoute du serveur
PORT=3000

# Si défini, toutes les routes /api/* (sauf /api/health) exigent l'en-tête X-Access-Code
ACCESS_CODE=

# Bornes de la boucle agentique
MAX_STEPS=6
MAX_OUTPUT_TOKENS=8000

# Durée maximale d'un flux SSE, en millisecondes
REQUEST_TIMEOUT_MS=120000

# Limites de débit par IP
RATE_CHAT_PER_HOUR=30
RATE_EXPORT_PER_MIN=10

# Corps de requête maximum, en octets
MAX_BODY_BYTES=1048576

# Niveau de journalisation : debug | info | warn | error
LOG_LEVEL=info

# Mettre à 1 pour lire l'IP client dans X-Forwarded-For (derrière un proxy)
TRUST_PROXY=0

# Origine autorisée pour un front séparé en développement (sinon : même origine)
ALLOWED_ORIGIN=

# Texte ajouté au pied de page des exports Word
EXPORT_FOOTER=Document généré avec assistance IA — à valider par un professionnel du droit avant signature.
